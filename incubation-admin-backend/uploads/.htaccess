# Defense-in-depth for user-uploaded files: this folder must NEVER be
# allowed to execute PHP (or any other script), even though
# incubation-image-upload.php already validates extension + real image
# content before anything lands here.

# Apache 2.4+ / typical Hostinger setup: disable the PHP handler entirely
# for this directory.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Belt-and-suspenders: explicitly deny access to anything that looks like
# a script, regardless of how PHP is wired up (mod_php, PHP-FPM handler,
# CGI, etc.).
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# No directory listing.
Options -Indexes
